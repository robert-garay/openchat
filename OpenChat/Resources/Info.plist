<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenChat</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OpenChat uses Bluetooth so agents can work with accessories you choose to enable.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>OpenChat reads your calendar so agents can help with schedules and meeting prep.</string>
	<key>NSCameraUsageDescription</key>
	<string>OpenChat uses the camera so agents can analyze photos or documents you capture.</string>
	<key>NSContactsUsageDescription</key>
	<string>OpenChat reads contacts you enable so agents can help with people and relationships.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>OpenChat reads Apple Health data you enable so agents can provide health analysis and coaching.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>OpenChat accesses HomeKit so agents can view and control homes you choose to enable.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OpenChat uses your location so agents can provide place-aware help while you use the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>OpenChat uses the microphone for voice input and transcription when you enable it.</string>
	<key>NSMotionUsageDescription</key>
	<string>OpenChat uses motion and fitness data so agents can understand activity and movement.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>OpenChat accesses photos you select so agents can analyze images.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
</dict>
</plist>
