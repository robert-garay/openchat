// Copy to Secrets.xcconfig (gitignored) and paste a spend-limited OpenRouter key.
// In OpenRouter: create a key, set a credit/monthly limit, and optionally allowlist
// only `qwen/qwen3.7-flash` so this key cannot be used for other models.
//
// project.yml already points Debug/Release at Configs/Secrets.xcconfig when present.
// Until you create Secrets.xcconfig, the app falls back to BYOK onboarding.

OPENCHAT_MANAGED_OPENROUTER_API_KEY = sk-or-v1-REPLACE_ME
