# Copy to fastlane/.env (gitignored) and fill in. Never commit real values.

# Apple ID email for App Store Connect (optional if using API key auth)
FASTLANE_APPLE_ID=you@example.com

# 10-character Apple Developer Team ID (same as Config/Local.xcconfig DEVELOPMENT_TEAM)
FASTLANE_TEAM_ID=XXXXXXXXXX

# App Store Connect team ID (usually same as FASTLANE_TEAM_ID; check ASC → Users and Access)
FASTLANE_ITC_TEAM_ID=XXXXXXXXXX

# App Store Connect API key (recommended for uploads; create at ASC → Users and Access → Keys)
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=/path/to/AuthKey_XXXXXX.p8

# Optional overrides
# BUILD_NUMBER=4
# TESTFLIGHT_CHANGELOG=OpenChat 1.1.0 beta
# FASTLANE_SKIP_GIT_CHECK=1
# FASTLANE_SKIP_WAIT=1
